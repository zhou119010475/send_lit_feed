# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env && chmod 600 .env
#
# Read by run_lit_feed_job.sh (which exports it for send_digest_html.py) and by
# lit_feed.py itself, via _load_local_env().

# Gmail App Password, from https://myaccount.google.com/apppasswords
# 16 characters, spaces stripped. The option only appears once 2-Step Verification
# is on for the account. Google revokes these periodically -- when the cron log
# shows "535 ... BadCredentials", generate a new one and replace it here only;
# nothing else needs to change.
LIT_SMTP_PASS=

# Optional. An NCBI API key raises the PubMed rate limit from 3 to 10 requests a
# second; the six PubMed feeds make about a dozen requests per run, so the job works
# without one. From https://account.ncbi.nlm.nih.gov/settings/
# NCBI_API_KEY=
